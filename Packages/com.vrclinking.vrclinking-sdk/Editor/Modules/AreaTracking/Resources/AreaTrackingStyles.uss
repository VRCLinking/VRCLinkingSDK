.tracking-root {
    flex-shrink: 0;
}

.tracking-header {
    background-color: rgba(0, 0, 0, 0.20);
    padding: 10px 12px;
}

.tracking-header-title-row,
.tracking-status-row,
.tracking-action-row,
.tracking-panel-heading-row,
.area-row,
.area-row-actions,
.validation-actions {
    flex-direction: row;
    align-items: center;
}

.tracking-header-title-row {
    margin-bottom: 6px;
}

.tracking-logo {
    background-image: resource("VRCL Logo NoBackground");
    -unity-background-scale-mode: scale-to-fit;
    width: 36px;
    height: 36px;
    margin-right: 8px;
}

.tracking-title {
    color: rgb(68, 197, 228);
    font-size: 21px;
    -unity-font-style: bold;
}

.tracking-world-status {
    color: rgb(190, 190, 190);
    margin-bottom: 4px;
}

.tracking-status {
    flex-grow: 1;
    -unity-font-style: bold;
}

.tracking-error-count {
    min-width: 84px;
}

.tracking-tabs {
    margin-bottom: 4px;
}

.tracking-tabs ToolbarToggle {
    flex-grow: 1;
    -unity-text-align: middle-center;
}

.tracking-panel {
    padding: 10px 8px 8px 8px;
}

.tracking-hidden {
    display: none;
}

.tracking-section-title {
    -unity-font-style: bold;
    font-size: 13px;
    margin-bottom: 6px;
}

.tracking-hint {
    color: rgb(155, 155, 155);
    font-size: 11px;
    white-space: normal;
    margin: 1px 3px 7px 3px;
}

.tracking-section-divider {
    height: 1px;
    background-color: rgba(128, 128, 128, 0.35);
    margin: 10px 0;
}

.tracking-action-row {
    justify-content: flex-end;
    margin-top: 6px;
}

.tracking-action-row Button {
    min-width: 105px;
    margin-left: 5px;
}

.primary-action {
    background-color: rgb(35, 94, 130);
    border-color: rgb(57, 132, 178);
    color: white;
    -unity-font-style: bold;
}

.tracking-panel-heading-row {
    justify-content: space-between;
}

.tracking-list {
    max-height: 520px;
}

.area-row {
    min-height: 42px;
    padding: 5px;
    margin-bottom: 4px;
    border-width: 1px;
    border-color: rgba(128, 128, 128, 0.45);
    border-radius: 3px;
    background-color: rgba(128, 128, 128, 0.08);
}

.area-row-main {
    flex-grow: 1;
    min-width: 100px;
}

.area-row-name {
    flex-grow: 1;
}

.area-row-meta {
    color: rgb(155, 155, 155);
    font-size: 10px;
    margin-left: 3px;
}

.area-row-actions Button,
.validation-actions Button {
    min-width: 28px;
    margin-left: 3px;
}

.area-excluded {
    opacity: 0.62;
}

.status-synced {
    color: rgb(91, 190, 116);
}

.status-dirty {
    color: rgb(224, 178, 70);
}

.status-unavailable {
    color: rgb(160, 160, 160);
}

.status-invalid {
    color: rgb(234, 91, 91);
}

.validation-row {
    padding: 7px;
    margin-bottom: 5px;
    border-left-width: 3px;
    background-color: rgba(128, 128, 128, 0.08);
}

.validation-message {
    white-space: normal;
    margin-bottom: 4px;
}

.validation-error {
    border-left-color: rgb(218, 70, 70);
}

.validation-warning {
    border-left-color: rgb(220, 168, 58);
}

.validation-info {
    border-left-color: rgb(68, 154, 201);
}
