<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="Root" class="tracking-root">
        <ui:VisualElement name="Header" class="tracking-header">
            <ui:VisualElement class="tracking-header-title-row">
                <ui:VisualElement class="tracking-logo" />
                <ui:Label text="Area Tracking" class="tracking-title" />
            </ui:VisualElement>
            <ui:Label name="WorldStatus" class="tracking-world-status" />
            <ui:VisualElement class="tracking-status-row">
                <ui:Label name="SyncStatus" class="tracking-status" />
                <ui:Button name="ErrorCount" text="0 blockers" class="tracking-error-count" />
            </ui:VisualElement>
        </ui:VisualElement>

        <uie:Toolbar class="tracking-tabs">
            <uie:ToolbarToggle name="SetupTab" text="Setup" value="true" />
            <uie:ToolbarToggle name="AreasTab" text="Areas" />
            <uie:ToolbarToggle name="MapTab" text="Map Snapshot" />
            <uie:ToolbarToggle name="ValidationTab" text="Validation" />
        </uie:Toolbar>

        <ui:VisualElement name="SetupPanel" class="tracking-panel">
            <ui:Label text="Runtime Settings" class="tracking-section-title" />
            <ui:Toggle name="TrackingEnabled" label="Tracking Enabled" />
            <ui:Slider name="HeartbeatInterval" label="Heartbeat Interval" low-value="30" high-value="120" show-input-field="true" />
            <ui:Label text="Seconds between periodic telemetry requests." class="tracking-hint" />
            <ui:Slider name="StartupDelay" label="Startup Delay" low-value="5" high-value="120" show-input-field="true" />
            <ui:Label text="Delay before the first request, allowing other world startup work to finish." class="tracking-hint" />
            <ui:VisualElement name="OutsideTrackingHelpBoxContainer" />

            <ui:VisualElement class="tracking-section-divider" />
            <ui:Label text="Server Configuration" class="tracking-section-title" />
            <ui:Label name="ServerComparison" text="Server status has not been checked." class="tracking-hint" />
            <ui:VisualElement class="tracking-action-row">
                <ui:Button name="RefreshServer" text="Refresh Status" />
                <ui:Button name="SyncAreas" text="Sync Areas" class="primary-action" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="AreasPanel" class="tracking-panel tracking-hidden">
            <ui:VisualElement class="tracking-panel-heading-row">
                <ui:VisualElement>
                    <ui:Label text="Discovered Areas" class="tracking-section-title" />
                    <ui:Label name="AreaSummary" class="tracking-hint" />
                </ui:VisualElement>
                <ui:Button name="AddArea" text="+ Add Area" class="primary-action" />
            </ui:VisualElement>
            <ui:ScrollView name="AreaList" class="tracking-list" />
        </ui:VisualElement>

        <ui:VisualElement name="MapPanel" class="tracking-panel tracking-hidden">
            <ui:Label text="Top-down World Snapshot" class="tracking-section-title" />
            <ui:Label text="Capture a tiled image separately from Sync Areas. Only the selected areas determine the map bounds and initial website overlays." class="tracking-hint" />
            <ui:DropdownField name="MapDestination" label="Destination" />
            <ui:TextField name="MapName" label="Map name" value="World Map" max-length="100" />
            <ui:DropdownField name="MapResolution" label="Resolution" />
            <ui:FloatField name="MapPadding" label="Padding (%)" value="10" />
            <ui:VisualElement name="MapLayerMaskContainer" />
            <uie:ColorField name="MapBackground" label="Background" value="#20252BFF" />
            <ui:Label name="MapCapabilities" text="Open this tab to load server capture limits." class="tracking-hint" />

            <ui:VisualElement class="tracking-section-divider" />
            <ui:VisualElement class="tracking-panel-heading-row">
                <ui:VisualElement>
                    <ui:Label text="Areas included in this map" class="tracking-section-title" />
                    <ui:Label name="MapAreaSummary" class="tracking-hint" />
                </ui:VisualElement>
                <ui:VisualElement class="map-selection-actions">
                    <ui:Button name="MapSelectRecommended" text="Recommended" />
                    <ui:Button name="MapSelectAll" text="All" />
                    <ui:Button name="MapSelectNone" text="None" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="MapSelectionWarningContainer" />
            <ui:ScrollView name="MapAreaList" class="tracking-list map-area-list" />

            <ui:VisualElement class="tracking-section-divider" />
            <ui:Label name="MapSnapshotStatus" text="Ready to analyze the scene." class="tracking-hint" />
            <ui:ProgressBar name="MapSnapshotProgress" title="" value="0" class="tracking-hidden" />
            <ui:VisualElement class="tracking-action-row">
                <ui:Button name="CancelMapSnapshot" text="Cancel" class="tracking-hidden" />
                <ui:Button name="TakeMapSnapshot" text="Take Snapshot" class="primary-action" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement name="ValidationPanel" class="tracking-panel tracking-hidden">
            <ui:Label text="Validation" class="tracking-section-title" />
            <ui:Label name="ValidationSummary" class="tracking-hint" />
            <ui:ScrollView name="ValidationList" class="tracking-list" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
